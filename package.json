{
  "name": "cafe-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:check": "node scripts/worker-size-check.mjs",
    "menu:export-fallback": "node --import ./scripts/ts-paths.mjs scripts/export-menu-fallback.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "~15.5.28",
    "qrcode-generator": "2.0.4",
    "react": "~19.1.10",
    "react-dom": "~19.1.10",
    "server-only": "^0.0.1",
    "zod": "~3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@opennextjs/cloudflare": "^1.20.16",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "~4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "~15.5.29",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.122.1",
    "tailwindcss": "~4.3.4",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "unrs-resolver",
      "sharp",
      "supabase"
    ]
  }
}
