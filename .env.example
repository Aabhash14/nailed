# Copy to .env.local (git-ignored). Names only: never commit real values. Full list: engineering/ops/env.md
# Public values (inlined into the browser bundle by design; RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Data mode (SEC-011). Empty/unset or "live" = real Supabase data (the default, and the ONLY value for staging and
# production). "mock" = sample data, fake admin login, orders reach nobody: for `pnpm dev` demos without a database
# and for the e2e build only. Any other value fails the build. Inlined at build time.
NEXT_PUBLIC_DATA_MODE=

# Build-guard override: "1" lets `next build` / `pnpm cf:build` run in mock mode. Leave it commented out here.
# WARNING: never keep it (or NEXT_PUBLIC_DATA_MODE=mock) in a .env.local on a machine you build deploys from: Next
# loads .env.local into every build, so a deploy would ship sample data. Set it inline for one command instead:
#   NEXT_PUBLIC_DATA_MODE=mock ALLOW_MOCK_BUILD=1 pnpm build
# `pnpm e2e` sets both itself (playwright.config.ts). CI sets them only on non-deploy build steps.
# ALLOW_MOCK_BUILD=

# Server-only values are NOT listed here. They go in .dev.vars locally (see .dev.vars.example)
# and `wrangler secret put` / wrangler.jsonc vars when deployed, so they can never be inlined into client code.
